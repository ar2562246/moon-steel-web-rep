# =============================================================================
# Moon Steel — environment variables
# Copy to `.env.local` (root) and/or `artifacts/moonsteel/.env.local` as needed.
# =============================================================================

# --- Next.js site (artifacts/moonsteel) --------------------------------------

# Google Analytics 4 — Moon Steel property 309315793. Loaded only in production.
GA_PROPERTY_ID=309315793
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-LQ83V349QZ

# Public site URL used for metadata, sitemap, and robots.txt
# Local: http://localhost:3000
# Production (Vercel): https://moonsteelfab.com  — never a *.vercel.app URL, no trailing slash
NEXT_PUBLIC_SITE_URL=https://moonsteelfab.com

# Supabase — required for admin login and content management
# Find these in Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only — contact form inserts (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Contact form notifications — Zoho SMTP (preferred)
CONTACT_NOTIFICATION_EMAIL=info@moonsteelfab.com
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@moonsteelfab.com
SMTP_PASS=
SMTP_FROM="Moon Steel <info@moonsteelfab.com>"

# Incoming mail (IMAP) — not used by the site; documented for mailbox setup
# IMAP_HOST=imappro.zoho.com
# IMAP_PORT=993

# Optional Resend fallback (used only if SMTP_HOST/USER/PASS are unset)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Moon Steel <noreply@yourdomain.com>

# --- Catalog platform sync (admin → Meta / WhatsApp / Google) ----------------
# Encrypts stored OAuth tokens. Generate a long random string (32+ chars).
SYNC_CREDENTIALS_ENCRYPTION_KEY=

# Meta app (Facebook Login for Business). Used for Facebook, Instagram, WhatsApp catalogs.
META_APP_ID=
META_APP_SECRET=

# Optional Cursor MCP fallback if Meta OAuth cannot complete in Cursor.
# Generate a User token in Graph API Explorer with ads_mcp_management + catalog_management.
# META_MCP_ACCESS_TOKEN=

# Google OAuth client for Merchant Center (scope: https://www.googleapis.com/auth/content)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional defaults applied after Google connect; can also be saved in Social Channels.
GOOGLE_MERCHANT_ID=
GOOGLE_MERCHANT_DATASOURCE_ID=
GOOGLE_MERCHANT_FEED_LABEL=PK
# Optional contact email passed to Merchant API developer registration.
# GOOGLE_MERCHANT_DEVELOPER_EMAIL=

# Development mock catalog. Defaults to on in non-production.
# CATALOG_SYNC_ENABLE_MOCK=true

