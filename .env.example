# =============================================================================
# Moon Steel — environment variables
# Copy to `.env.local` (root) and/or `artifacts/moonsteel/.env.local` as needed.
# =============================================================================

# --- Next.js site (artifacts/moonsteel) --------------------------------------

# Public site URL used for metadata, sitemap, and robots.txt
# Production (Vercel): set to your live domain, e.g. https://moon-steel-web-rep.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — required for admin login and content management
# Find these in Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only — contact form inserts (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Contact form notifications — Zoho SMTP (preferred)
CONTACT_NOTIFICATION_EMAIL=info@moonsteelfab.com
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@moonsteelfab.com
SMTP_PASS=
SMTP_FROM="Moon Steel <info@moonsteelfab.com>"

# Incoming mail (IMAP) — not used by the site; documented for mailbox setup
# IMAP_HOST=imappro.zoho.com
# IMAP_PORT=993

# Optional Resend fallback (used only if SMTP_HOST/USER/PASS are unset)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Moon Steel <noreply@yourdomain.com>
